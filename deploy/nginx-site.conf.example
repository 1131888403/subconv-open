server {
    listen 80;
    server_name subconv.example.com;
    root /var/www/subconv;
    location ^~ /.well-known/acme-challenge/ { try_files $uri =404; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl http2;
    server_name subconv.example.com;
    ssl_certificate /etc/letsencrypt/live/subconv.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/subconv.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    location = /health { proxy_pass http://127.0.0.1:8787/health; proxy_set_header Host $host; }
    # Set server_name and certificate paths for your domain.
    # Personal browser endpoint: Nginx keeps the upstream token server-side.
    # It accepts only URL + preset UA and forwards the token internally.
    location = /my-fetch {
        proxy_pass http://127.0.0.1:8787/fetch?token=__SUBCONV_TOKEN__&url=$arg_url&ua=$arg_ua&tag=$arg_tag;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 10s;
        proxy_read_timeout 35s;
    }
    # Creates an opaque client subscription link; token remains server-side.
    location = /my-create {
        proxy_pass http://127.0.0.1:8787/create?token=__SUBCONV_TOKEN__&url=$arg_url&ua=$arg_ua&tag=$arg_tag&target=$arg_target&options=$arg_options;
        proxy_set_header Host $host;
        proxy_connect_timeout 10s;
        proxy_read_timeout 15s;
    }
    # Client-facing opaque relay: /sub/<random-id>
    location ^~ /sub/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_connect_timeout 10s;
        proxy_read_timeout 35s;
    }
    # Direct API endpoint; requires the server-side token explicitly.
    location = /fetch {
        proxy_pass http://127.0.0.1:8787/fetch;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 10s;
        proxy_read_timeout 35s;
    }
    root /var/www/subconv;
    location / { try_files $uri $uri/ /index.html; }
}
